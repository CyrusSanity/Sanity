local function hardTriggerPrompt(prompt)
    if not prompt.Enabled then return end
    pcall(function() fireproximityprompt(prompt) end)
    if getconnections then
        pcall(function()
            local connections = getconnections(prompt.Triggered)
            for _, conn in ipairs(connections) do
                if conn.Fire then conn:Fire(0) end
            end
        end)
    end
    pcall(function()
        local key = Enum.KeyCode.E
        if prompt.KeyboardKeyCode then key = prompt.KeyboardKeyCode end
        VIM:SendKeyEvent(true, key, false, game)
        VIM:SendKeyEvent(false, key, false, game)
    end)
end

local function autoSelectJob(targetJob)
    local Menu = PlayerGui:FindFirstChild("Menu")
    local Container = Menu and Menu:FindFirstChild("Container")
    local JobSelection = Container and Container:FindFirstChild("JobSelection")
    if not JobSelection then return end
    local Cards = JobSelection:FindFirstChild("Cards")
    if not Cards then return end
    
    if not JobSelection.Visible then
        local JobAction = ReplicatedStorage:FindFirstChild("Network"):FindFirstChild("Events"):FindFirstChild("JobAction")
        if JobAction then JobAction:FireServer("View") end
        task.wait(0.5)
    end
    for _, child in ipairs(Cards:GetChildren()) do
        local jobId = child:GetAttribute("JobId") or child.Name
        if child:IsA("Frame") and jobId == targetJob then
            local Select = child:FindFirstChild("Select")
            if Select and Select:IsA("ImageButton") then
                local Label = Select:FindFirstChild("ActionTitle")
                if Label and (Label.Text == "SELECT" or Label.Text == "OFF-DUTY") then
                    Select:Activate()
                    return true
                end
            end
        end
    end
    return false
end

