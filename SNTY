local function buyItem(shopName, itemName, price)
    local purchased = false
    local char = getChar()
    
    pcall(function()
        local rs = game:GetService("ReplicatedStorage")
        local purchaseEvent = rs:FindFirstChild("PurchaseEvent") or rs:FindFirstChild("BuyItem") or rs:FindFirstChild("ShopPurchase") or rs:FindFirstChild("Purchase")
        if purchaseEvent and purchaseEvent:IsA("RemoteEvent") then
            purchaseEvent:FireServer(shopName, itemName, price)
            purchased = true
        end
        local shopFolder = rs:FindFirstChild(shopName) or rs:FindFirstChild("Shared")
        if shopFolder then
            local events = shopFolder:FindFirstChild("Events") or shopFolder:FindFirstChild("Remotes")
            if events then
                local buyRemote = events:FindFirstChild("Purchase") or events:FindFirstChild("Buy")
                if buyRemote and buyRemote:IsA("RemoteEvent") then
                    buyRemote:FireServer(itemName, price)
                    purchased = true
                end
            end
        end
    end)

    if not purchased and char and char:FindFirstChild("HumanoidRootPart") then
        local shopDisplays = workspace:FindFirstChild("ShopDisplays")
        if shopDisplays then
            for _, display in ipairs(shopDisplays:GetDescendants()) do
                if display:IsA("Model") or display:IsA("Part") then
                    local displayName = display.Name:lower()
                    if displayName:find(itemName:lower()) or displayName:find(shopName:lower()) then
                        for _, prompt in ipairs(display:GetDescendants()) do
                            if prompt:IsA("ProximityPrompt") then
                                local part = prompt.Parent
                                if part:IsA("BasePart") then
                                    char.HumanoidRootPart.CFrame = part.CFrame * CFrame.new(0, 0, 4)
                                    task.wait(0.5)
                                    hardTriggerPrompt(prompt)
                                    purchased = true
                                    break
                                end
                            end
                        end
                    end
                end
                if purchased then break end
            end
        end
    end
end

